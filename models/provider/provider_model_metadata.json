    "n_providers_scored": 2368,
    "note_on_population": "Scored population = providers with billing activity in the latest year (2024), since 'latest-year' snapshot features require a 2024 record. Providers active only in earlier years (445 NPIs) are excluded from the current-risk scoring population; see limitations."
  },
  "feature_engineering": {
    "n_features_engineered_before_selection": 42,
    "n_features_removed_as_redundant": 4,
    "removed_features": [
      "latest_medical_payment_share (perfectly collinear with latest_drug_payment_share)",
      "latest_top_hcpcs_share (r=0.98 with latest_hcpcs_hhi)",
      "first_year (raw calendar identifier)",
      "last_year (raw calendar identifier)"
    ],
    "n_final_ml_features": 40,
    "feature_categories": [
      "utilization",
      "financial",
      "service_mix",
      "temporal/trend",
      "peer_deviation (vs. same provider_type/specialty)"
    ]
  },
  "preprocessing_pipeline": {
    "steps": [
      "SimpleImputer(strategy=median)",
      "Winsorizer(lower_pct=1.0, upper_pct=99.0) [custom transformer, provider_preprocessing.py]",
      "RobustScaler()"
    ],
    "missingness_indicators": [
      "peer_dev_latest_hcpcs_hhi_missing",
      "peer_dev_latest_drug_payment_share_missing"
    ],
    "deterministic": true
  },
  "risk_scoring_methodology": {
    "raw_anomaly_score": "negative of sklearn IsolationForest.decision_function (higher = more anomalous)",
    "anomaly_flag": "1 if IsolationForest.predict == -1 under contamination=0.05, else 0",
    "risk_score_0_100": "min-max normalization of raw_anomaly_score across the scored population, scaled to 0-100",
    "risk_categories": {
      "Low": "0-24",
      "Medium": "25-49",
      "High": "50-74",
      "Critical": "75-100"
    },
    "IMPORTANT_disclaimer": "The risk score is NOT a probability of fraud and does not indicate confirmed wrongdoing. It quantifies relative behavioral anomalousness within this provider population, for investigation prioritization only."
