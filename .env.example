# =====================================================================
# Copy to .env and fill in real values. Never commit .env.
# Only LLM_API_KEY must be filled in; everything else has working defaults.
# =====================================================================

# ---------- Application ----------
APP_NAME=healthcare-fraud-investigation-assistant
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Phase 1: knowledge base paths ----------
KNOWLEDGE_BASE_DIR=backend/knowledge
VECTOR_STORE_DIR=vector_store

# ---------- Phase 2/3: embeddings + FAISS ----------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=800
CHUNK_OVERLAP=120
FAISS_INDEX_NAME=knowledge_index
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.22
RETRIEVAL_MAX_PER_DOC=4
# Hybrid retrieval: dense + BM25 fused with Reciprocal Rank Fusion.
USE_HYBRID_SEARCH=true

# ---------- Phase 4: LLM ----------
# OPTION A - OpenAI (default). Key: https://platform.openai.com/api-keys
#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#LLM_BASE_URL=
#LLM_API_KEY=sk-your-key-here

# OPTION B - Google Gemini. Key: https://aistudio.google.com/apikey
# Comment out the four lines above and uncomment these four instead.
# No code changes needed - Gemini exposes an OpenAI-compatible endpoint.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=AQ.Ab8RN6KNqeTS7vlXLG8uRsxgPDuSxey6trmfi2CrGXOECWlQGw
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200

# ---------- Phase 5: API ----------
API_HOST=0.0.0.0
API_PORT=8732
CORS_ALLOWED_ORIGINS=http://localhost:5193,http://127.0.0.1:5193

# ---------- Phase 8: structured data layer ----------
# The ETL's curated tables. If set (or found in a sibling ETL project), these
# take precedence over the assistant's own warehouse, so the assistant and the
# ML agents always report identical numbers.
CURATED_DIR=
DATA_RAW_DIR=data_raw
DATA_STORE_DIR=data_store
# Peer cohorts smaller than this fall back to a national cohort.
MIN_PEER_COHORT=20

# ---------- Multi-agent bridge ----------
# When deployed inside the main project repo the multi_agent package is
# importable and the assistant calls Orchestrator().investigate_provider()
# directly, using the platform's synthesis score. Outside the repo it falls
# back to the provider risk model. Set to true to force the fallback.
DISABLE_AGENT_BRIDGE=
# Ceiling on one agent investigation. Investigating a provider runs several
# agents; a slow run falls back to the provider risk model rather than holding
# the request open.
AGENT_TIMEOUT_SECONDS=45

# ---------- Phase 9: risk engine ----------
# Risk model output is read from data_raw/provider_risk_scores.csv via the
# warehouse. No separate connection settings are required.
